# Supabase
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_KEY=service_role_jwt
DATABASE_URL=postgresql+asyncpg://postgres:password@host:5432/postgres
# Only needed once AUTH_MODE=supabase (real login isn't built yet -- see
# app/security.py). Find it in Supabase: Project Settings -> API -> JWT Secret.
SUPABASE_JWT_SECRET=

# Upstash Redis (Celery broker/cache)
UPSTASH_REDIS_URL=rediss://default:password@host:6379

# Anthropic
ANTHROPIC_API_KEY=anthropic_api_key
DEFAULT_LLM_MODEL=claude-opus-5

# App behavior toggles (dev-only overrides; production envs use the live values)
STORAGE_BACKEND=supabase   # supabase | local
LLM_PROVIDER_MODE=live     # live | fake
CELERY_TASK_ALWAYS_EAGER=false
AUTH_MODE=supabase         # supabase | dev
# Placeholder single-key auth for future non-browser API consumers -- nothing
# checks this yet (see app/security.py:check_api_key), safe to leave blank.
INTERNAL_API_KEY=

CORS_ORIGINS=["http://localhost:5173"]
